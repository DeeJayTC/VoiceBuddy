<Window x:Class="VoiceBuddy.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="VoiceBuddy"
        Width="960" Height="760" MinWidth="820" MinHeight="640"
        Background="{StaticResource Bg}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
  <Window.Resources>
    <Style TargetType="{x:Type StackPanel}" x:Key="Row">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style TargetType="{x:Type Label}" x:Key="RowLabel">
      <Setter Property="Width" Value="126" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="LayoutTabs" TargetType="{x:Type TabControl}" BasedOn="{StaticResource {x:Type TabControl}}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Margin" Value="0,2,0,0" />
    </Style>
    <Style x:Key="LayoutTabItem" TargetType="{x:Type TabItem}" BasedOn="{StaticResource {x:Type TabItem}}">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="14,6" />
    </Style>
    <Style x:Key="PrimaryTabs" TargetType="{x:Type TabControl}" BasedOn="{StaticResource {x:Type TabControl}}">
      <Setter Property="Margin" Value="0,2,0,0" />
    </Style>
    <Style x:Key="PrimaryTabItem" TargetType="{x:Type TabItem}" BasedOn="{StaticResource {x:Type TabItem}}">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Padding" Value="20,9" />
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- HEADER -->
    <Border Grid.Row="0" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#1A2130" Offset="0" />
          <GradientStop Color="#151B28" Offset="1" />
        </LinearGradientBrush>
      </Border.Background>
      <Grid Margin="20,14">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <!-- LogoImage is shown when Assets/deepl-logo.png is present at runtime;
               Placeholder renders otherwise. Toggle happens in MainWindow.TryLoadLogo(). -->
          <Border Width="38" Height="38" Background="#111826" CornerRadius="10" BorderBrush="#2B354A" BorderThickness="1">
            <Grid>
              <Grid x:Name="LogoPlaceholder">
                <Rectangle Fill="{StaticResource Accent}" RadiusX="8" RadiusY="8" />
                <Path Data="M 8,10 L 26,10 L 26,20 L 17,20 L 13,24 L 13,20 L 8,20 Z" Fill="White" />
              </Grid>
              <Image x:Name="LogoImage" Stretch="Uniform" Visibility="Collapsed" />
            </Grid>
          </Border>
          <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="VoiceBuddy" FontSize="19" FontWeight="SemiBold" />
            <TextBlock Text="{DynamicResource Loc_App_Tagline}" FontSize="11"
                       Foreground="{StaticResource Muted}" Margin="0,2,0,0" />
          </StackPanel>
        </StackPanel>

        <!-- Session indicator in the header's right edge -->
        <Border Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                Background="#111826" BorderBrush="#2B354A" BorderThickness="1"
                CornerRadius="999" Padding="12,6">
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="HeaderSessionDot" Width="8" Height="8" Fill="{StaticResource Muted}" VerticalAlignment="Center" />
            <TextBlock x:Name="HeaderSessionText" Text="Idle" Margin="8,0,0,0"
                       Foreground="{StaticResource Muted}" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <!-- TABS -->
    <TabControl Grid.Row="1" Margin="20,10,20,16"
                Style="{StaticResource PrimaryTabs}"
                ItemContainerStyle="{StaticResource PrimaryTabItem}">

      <!-- OVERVIEW -->
      <TabItem Header="{DynamicResource Loc_Tabs_Overview}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,14,0,0">
          <StackPanel MaxWidth="720" HorizontalAlignment="Left">
            <GroupBox Header="{DynamicResource Loc_Overview_AudioSource}">
              <StackPanel>
                <StackPanel Style="{StaticResource Row}">
                  <Label Style="{StaticResource RowLabel}" Content="{DynamicResource Loc_Overview_Device}" />
                  <ComboBox x:Name="DeviceBox" Width="360" SelectionChanged="DeviceBox_SelectionChanged" />
                  <Button Content="{DynamicResource Loc_Overview_Refresh}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="RefreshDevicesButton_Click" />
                </StackPanel>
                <StackPanel Style="{StaticResource Row}">
                  <Label Style="{StaticResource RowLabel}" Content="{DynamicResource Loc_Overview_Level}" />
                  <Border Width="360" Height="14" Background="#0B0D12" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="3">
                    <Grid HorizontalAlignment="Stretch">
                      <Rectangle x:Name="VuBar" Fill="{StaticResource Accent}" HorizontalAlignment="Left" Width="0" RadiusX="2" RadiusY="2" />
                    </Grid>
                  </Border>
                </StackPanel>
                <StackPanel Style="{StaticResource Row}">
                  <Label Style="{StaticResource RowLabel}" Content="{DynamicResource Loc_Overview_Format}" />
                  <TextBlock x:Name="StatusText" Foreground="{StaticResource Muted}" Text="Idle" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="120,6,0,0">
                  <Button x:Name="CaptureToggleButton" Content="Start capture" Click="CaptureToggleButton_Click" />
                </StackPanel>
              </StackPanel>
            </GroupBox>

            <GroupBox Header="{DynamicResource Loc_Overview_TranslationOutput}">
              <StackPanel>
                <CheckBox x:Name="CaptionsEnabledCheck" Content="{DynamicResource Loc_Overview_CaptionsLabel}"
                          Margin="0,2,0,6"
                          Checked="CaptionsEnabledCheck_Changed" Unchecked="CaptionsEnabledCheck_Changed" />
                <CheckBox x:Name="VoiceEnabledCheck" Content="{DynamicResource Loc_Overview_VoiceLabel}"
                          Margin="0,2,0,6"
                          Checked="VoiceEnabledCheck_Changed" Unchecked="VoiceEnabledCheck_Changed" />
                <Grid x:Name="VoiceOutConfig" Visibility="Collapsed" Margin="24,4,0,0">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <StackPanel Grid.Row="0" Style="{StaticResource Row}">
                    <Label Style="{StaticResource RowLabel}" Content="{DynamicResource Loc_Overview_OutputDevice}" />
                    <ComboBox x:Name="VoiceOutDeviceBox" Width="320" SelectionChanged="VoiceOutDeviceBox_SelectionChanged" />
                    <Button Content="{DynamicResource Loc_Overview_Refresh}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="RefreshVoiceOutDevicesButton_Click" />
                  </StackPanel>
                  <StackPanel Grid.Row="1" Style="{StaticResource Row}">
                    <Label Style="{StaticResource RowLabel}" Content="{DynamicResource Loc_Overview_Voice}" />
                    <ComboBox x:Name="VoiceGenderBox" Width="220" SelectionChanged="VoiceGenderBox_SelectionChanged">
                      <ComboBoxItem Content="Auto (language default)" Tag="" />
                      <ComboBoxItem Content="female" Tag="female" />
                      <ComboBoxItem Content="male" Tag="male" />
                    </ComboBox>
                  </StackPanel>
                  <TextBlock Grid.Row="2" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="120,2,0,0"
                             Text="{DynamicResource Loc_Overview_VoiceCableHint}" />
                </Grid>
                <StackPanel Style="{StaticResource Row}" Margin="0,8,0,0">
                  <Label Style="{StaticResource RowLabel}" Content="{DynamicResource Loc_Overview_Session}" />
                  <TextBlock x:Name="VoiceStatus" Foreground="{StaticResource Muted}" Text="Idle" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="120,2,0,0"
                           Text="{DynamicResource Loc_Overview_SessionHint}" />
              </StackPanel>
            </GroupBox>

            <GroupBox Header="{DynamicResource Loc_Overview_Testing}">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                  <Button Content="{DynamicResource Loc_Overview_FireTestSubtitle}" Click="TestFireButton_Click" />
                  <TextBlock Foreground="{StaticResource Muted}" FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center"
                             Text="{DynamicResource Loc_Overview_FireTestHint}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,2">
                  <Button Content="{DynamicResource Loc_Overview_ClearCaptions}" Click="ClearCaptionsButton_Click" />
                  <TextBlock Foreground="{StaticResource Muted}" FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center"
                             Text="{DynamicResource Loc_Overview_ClearCaptionsHint}" />
                </StackPanel>
              </StackPanel>
            </GroupBox>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- SETTINGS -->
      <TabItem Header="{DynamicResource Loc_Tabs_Settings}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,14,0,0">
          <StackPanel MaxWidth="720" HorizontalAlignment="Left">
            <GroupBox Header="{DynamicResource Loc_Settings_DeepLVoiceCredentials}">
              <StackPanel>
                <StackPanel Style="{StaticResource Row}">
                  <Label Style="{StaticResource RowLabel}" Content="{DynamicResource Loc_Settings_TargetLang}" />
                  <ComboBox x:Name="TargetLangBox" Width="260"
                            IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True"
                            TextSearch.TextPath="Label"
                            SelectionChanged="TargetLangBox_SelectionChanged"
                            LostFocus="TargetLangBox_LostFocus">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Label}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBlock Foreground="{StaticResource Muted}" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center"
                             Text="{DynamicResource Loc_Settings_TargetLangHint}" />
                </StackPanel>
                <StackPanel Style="{StaticResource Row}">
                  <Label Style="{StaticResource RowLabel}" Content="{DynamicResource Loc_Settings_SourceLang}" />
                  <ComboBox x:Name="SourceLangBox" Width="260"
                            IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True"
                            TextSearch.TextPath="Label"
                            SelectionChanged="SourceLangBox_SelectionChanged"
                            LostFocus="SourceLangBox_LostFocus">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Label}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBlock Foreground="{StaticResource Muted}" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center"
                             Text="{DynamicResource Loc_Settings_SourceLangHint}" />
                </StackPanel>
                <StackPanel Style="{StaticResource Row}">
                  <Label Style="{StaticResource RowLabel}" Content="{DynamicResource Loc_Settings_Host}" />
                  <ComboBox x:Name="HostBox" Width="260" SelectionChanged="HostBox_SelectionChanged">
                    <ComboBoxItem Content="api-free.deepl.com" />
                    <ComboBoxItem Content="api.deepl.com" />
                  </ComboBox>
                </StackPanel>
                <StackPanel Style="{StaticResource Row}">
                  <Label Style="{StaticResource RowLabel}" Content="{DynamicResource Loc_Settings_ApiKey}" />
                  <PasswordBox x:Name="ApiKeyBox" Width="360" PasswordChanged="ApiKeyBox_PasswordChanged" />
                </StackPanel>
                <TextBlock Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="120,4,0,0"
                           Text="{DynamicResource Loc_Settings_ApiKeyHint}" />
              </StackPanel>
            </GroupBox>

            <GroupBox Header="{DynamicResource Loc_Settings_SubtitleBehavior}">
              <StackPanel>
                <CheckBox x:Name="ShowOriginalCheck" Content="{DynamicResource Loc_Settings_ShowOriginal}"
                          Margin="0,2,0,4"
                          Checked="ShowOriginalCheck_Changed" Unchecked="ShowOriginalCheck_Changed" />
              </StackPanel>
            </GroupBox>

            <GroupBox Header="{DynamicResource Loc_Settings_AppLanguage}">
              <StackPanel>
                <StackPanel Style="{StaticResource Row}">
                  <Label Style="{StaticResource RowLabel}" Content="{DynamicResource Loc_Settings_Language}" />
                  <ComboBox x:Name="LanguageBox" Width="260"
                            SelectionChanged="LanguageBox_SelectionChanged" />
                </StackPanel>
                <TextBlock Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="120,4,0,0"
                           Text="{DynamicResource Loc_Settings_AppLanguageHint}" />
              </StackPanel>
            </GroupBox>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- DEBUG -->
      <TabItem Header="{DynamicResource Loc_Tabs_Debug}">
        <Grid Margin="0,14,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <Border Grid.Row="0" Background="{StaticResource Panel}"
                  BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="10" Padding="12,10">
            <StackPanel Orientation="Horizontal">
              <CheckBox x:Name="DebugEnabledCheck" Content="{DynamicResource Loc_Debug_LogApiTraffic}" VerticalAlignment="Center"
                        Checked="DebugEnabledCheck_Changed" Unchecked="DebugEnabledCheck_Changed" />
              <CheckBox x:Name="DebugChunksCheck" Content="{DynamicResource Loc_Debug_IncludeAudioChunks}" VerticalAlignment="Center"
                        Margin="16,0,0,0"
                        Checked="DebugChunksCheck_Changed" Unchecked="DebugChunksCheck_Changed" />
              <CheckBox x:Name="DebugAutoScrollCheck" Content="{DynamicResource Loc_Debug_AutoScroll}" IsChecked="True" VerticalAlignment="Center"
                        Margin="16,0,0,0" />
              <Button Content="{DynamicResource Loc_Debug_Clear}" Style="{StaticResource SecondaryButton}" Margin="16,0,0,0"
                      Click="DebugClearButton_Click" />
              <TextBlock x:Name="DebugStats" Foreground="{StaticResource Muted}" FontSize="11"
                         VerticalAlignment="Center" Margin="16,0,0,0" Text="0 entries" />
            </StackPanel>
          </Border>

          <Border Grid.Row="1" Background="#0B0D12" BorderBrush="{StaticResource Border}"
                  BorderThickness="1" CornerRadius="10" Margin="0,10,0,0">
            <ScrollViewer x:Name="DebugScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
              <TextBox x:Name="DebugText"
                       Background="Transparent" BorderThickness="0"
                       Foreground="{StaticResource Text}"
                       FontFamily="Consolas,Cascadia Mono,Courier New" FontSize="11"
                       IsReadOnly="True" IsReadOnlyCaretVisible="False"
                       TextWrapping="NoWrap"
                       AcceptsReturn="True"
                       Padding="10" />
            </ScrollViewer>
          </Border>
        </Grid>
      </TabItem>

      <!-- LAYOUT -->
      <TabItem Header="{DynamicResource Loc_Tabs_Layout}">
        <Grid Margin="0,14,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="1.1*" />
          </Grid.ColumnDefinitions>

          <!-- Style controls -->
          <Border Grid.Column="0" Background="{StaticResource Panel}"
                  BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="10" Padding="14">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Loc_Layout_SubtitleStyle}" />

                <TabControl Style="{StaticResource LayoutTabs}" ItemContainerStyle="{StaticResource LayoutTabItem}">
                  <TabItem Header="{DynamicResource Loc_Layout_Typography}">
                    <StackPanel Margin="0,10,0,0">
                      <Border Background="#111826" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                          <StackPanel Style="{StaticResource Row}">
                            <Label Style="{StaticResource RowLabel}" Content="{DynamicResource Loc_Layout_FontFamily}" />
                            <TextBox x:Name="FontFamilyBox" Width="260" TextChanged="FontFamilyBox_TextChanged" />
                          </StackPanel>
                          <StackPanel Style="{StaticResource Row}">
                            <Label Style="{StaticResource RowLabel}" Content="{DynamicResource Loc_Layout_Size}" />
                            <Slider x:Name="FontSizeSlider" Minimum="12" Maximum="72" Width="220" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="FontSizeSlider_ValueChanged" />
                            <TextBlock x:Name="FontSizeValue" Width="40" TextAlignment="Right" Foreground="{StaticResource Muted}" Margin="8,0,0,0" />
                          </StackPanel>
                          <StackPanel Style="{StaticResource Row}">
                            <Label Style="{StaticResource RowLabel}" Content="{DynamicResource Loc_Layout_Weight}" />
                            <ComboBox x:Name="WeightBox" Width="120" SelectionChanged="WeightBox_SelectionChanged">
                              <ComboBoxItem Content="400" />
                              <ComboBoxItem Content="500" />
                              <ComboBoxItem Content="600" />
                              <ComboBoxItem Content="700" />
                              <ComboBoxItem Content="800" />
                            </ComboBox>
                          </StackPanel>
                          <StackPanel Style="{StaticResource Row}">
                            <Label Style="{StaticResource RowLabel}" Content="{DynamicResource Loc_Layout_Align}" />
                            <ComboBox x:Name="AlignBox" Width="120" SelectionChanged="AlignBox_SelectionChanged">
                              <ComboBoxItem Content="Left" />
                              <ComboBoxItem Content="Center" />
                              <ComboBoxItem Content="Right" />
                            </ComboBox>
                          </StackPanel>
                          <StackPanel Style="{StaticResource Row}">
                            <Label Style="{StaticResource RowLabel}" Content="{DynamicResource Loc_Layout_Color}" />
                            <TextBox x:Name="TextColorBox" Width="90" TextChanged="TextColorBox_TextChanged" />
                            <Button Style="{StaticResource SecondaryButton}" Content="{DynamicResource Loc_Layout_Pick}" Margin="8,0,0,0" Padding="10,4" Click="TextColorPickButton_Click" />
                            <Border x:Name="TextColorSwatch" Width="24" Height="24" Margin="8,0,0,0" CornerRadius="4" BorderThickness="1" BorderBrush="{StaticResource Border}" />
                          </StackPanel>
                          <StackPanel Style="{StaticResource Row}">
                            <Label Style="{StaticResource RowLabel}" Content="{DynamicResource Loc_Layout_LineHeight}" />
                            <Slider x:Name="LineHeightSlider" Minimum="0.8" Maximum="2.0" Width="220" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="LineHeightSlider_ValueChanged" />
                            <TextBlock x:Name="LineHeightValue" Width="40" TextAlignment="Right" Foreground="{StaticResource Muted}" Margin="8,0,0,0" />
                          </StackPanel>
                        </StackPanel>
                      </Border>

                      <Border Background="#111826" CornerRadius="10" Padding="12">
                        <StackPanel>
                          <StackPanel Style="{StaticResource Row}">
                            <Label Style="{StaticResource RowLabel}" Content="{DynamicResource Loc_Layout_PanelColor}" />
                            <TextBox x:Name="PanelBgColorBox" Width="90" TextChanged="PanelBgColorBox_TextChanged" />
                            <Button Style="{StaticResource SecondaryButton}" Content="{DynamicResource Loc_Layout_Pick}" Margin="8,0,0,0" Padding="10,4" Click="PanelBgColorPickButton_Click" />
                            <Border x:Name="PanelBgColorSwatch" Width="24" Height="24" Margin="8,0,0,0" CornerRadius="4" BorderThickness="1" BorderBrush="{StaticResource Border}" />
                          </StackPanel>
                          <StackPanel Style="{StaticResource Row}">
                            <Label Style="{StaticResource RowLabel}" Content="{DynamicResource Loc_Layout_PanelOpacity}" />
                            <Slider x:Name="PanelBgOpacitySlider" Minimum="0" Maximum="1" Width="220" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="PanelBgOpacitySlider_ValueChanged" />
                            <TextBlock x:Name="PanelBgOpacityValue" Width="40" TextAlignment="Right" Foreground="{StaticResource Muted}" Margin="8,0,0,0" />
                          </StackPanel>
                          <TextBlock Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="120,2,0,0"
                                     Text="{DynamicResource Loc_Layout_PanelOpacityHint}" />
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </TabItem>

                  <TabItem Header="{DynamicResource Loc_Layout_Bubble}">
                    <Border Background="#111826" CornerRadius="10" Padding="12" Margin="0,10,0,0">
                      <StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                          <Label Style="{StaticResource RowLabel}" Content="{DynamicResource Loc_Layout_OutlineColor}" />
                          <TextBox x:Name="OutlineColorBox" Width="90" TextChanged="OutlineColorBox_TextChanged" />
                            <Button Style="{StaticResource SecondaryButton}" Content="{DynamicResource Loc_Layout_Pick}" Margin="8,0,0,0" Padding="10,4" Click="OutlineColorPickButton_Click" />
                          <Border x:Name="OutlineColorSwatch" Width="24" Height="24" Margin="8,0,0,0" CornerRadius="4" BorderThickness="1" BorderBrush="{StaticResource Border}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                          <Label Style="{StaticResource RowLabel}" Content="{DynamicResource Loc_Layout_OutlineWidth}" />
                          <Slider x:Name="OutlineWidthSlider" Minimum="0" Maximum="8" Width="220" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OutlineWidthSlider_ValueChanged" />
                          <TextBlock x:Name="OutlineWidthValue" Width="40" TextAlignment="Right" Foreground="{StaticResource Muted}" Margin="8,0,0,0" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                          <Label Style="{StaticResource RowLabel}" Content="{DynamicResource Loc_Layout_Background}" />
                          <TextBox x:Name="BgColorBox" Width="90" TextChanged="BgColorBox_TextChanged" />
                            <Button Style="{StaticResource SecondaryButton}" Content="{DynamicResource Loc_Layout_Pick}" Margin="8,0,0,0" Padding="10,4" Click="BgColorPickButton_Click" />
                          <Border x:Name="BgColorSwatch" Width="24" Height="24" Margin="8,0,0,0" CornerRadius="4" BorderThickness="1" BorderBrush="{StaticResource Border}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                          <Label Style="{StaticResource RowLabel}" Content="{DynamicResource Loc_Layout_BgOpacity}" />
                          <Slider x:Name="BgOpacitySlider" Minimum="0" Maximum="1" Width="220" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="BgOpacitySlider_ValueChanged" />
                          <TextBlock x:Name="BgOpacityValue" Width="40" TextAlignment="Right" Foreground="{StaticResource Muted}" Margin="8,0,0,0" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                          <Label Style="{StaticResource RowLabel}" Content="{DynamicResource Loc_Layout_PaddingX}" />
                          <Slider x:Name="PadXSlider" Minimum="0" Maximum="40" Width="220" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="PadXSlider_ValueChanged" />
                          <TextBlock x:Name="PadXValue" Width="40" TextAlignment="Right" Foreground="{StaticResource Muted}" Margin="8,0,0,0" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                          <Label Style="{StaticResource RowLabel}" Content="{DynamicResource Loc_Layout_PaddingY}" />
                          <Slider x:Name="PadYSlider" Minimum="0" Maximum="40" Width="220" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="PadYSlider_ValueChanged" />
                          <TextBlock x:Name="PadYValue" Width="40" TextAlignment="Right" Foreground="{StaticResource Muted}" Margin="8,0,0,0" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                          <Label Style="{StaticResource RowLabel}" Content="{DynamicResource Loc_Layout_Radius}" />
                          <Slider x:Name="RadiusSlider" Minimum="0" Maximum="32" Width="220" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="RadiusSlider_ValueChanged" />
                          <TextBlock x:Name="RadiusValue" Width="40" TextAlignment="Right" Foreground="{StaticResource Muted}" Margin="8,0,0,0" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                          <Label Style="{StaticResource RowLabel}" Content="{DynamicResource Loc_Layout_MaxLines}" />
                          <Slider x:Name="MaxLinesSlider" Minimum="1" Maximum="6" Width="220" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="MaxLinesSlider_ValueChanged" />
                          <TextBlock x:Name="MaxLinesValue" Width="40" TextAlignment="Right" Foreground="{StaticResource Muted}" Margin="8,0,0,0" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                          <Label Style="{StaticResource RowLabel}" Content="{DynamicResource Loc_Layout_VisibleSentences}" />
                          <Slider x:Name="MaxSentencesSlider" Minimum="1" Maximum="15" Width="220" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="MaxSentencesSlider_ValueChanged" />
                          <TextBlock x:Name="MaxSentencesValue" Width="40" TextAlignment="Right" Foreground="{StaticResource Muted}" Margin="8,0,0,0" />
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </TabItem>

                  <TabItem Header="{DynamicResource Loc_Layout_Timing}">
                    <Border Background="#111826" CornerRadius="10" Padding="12" Margin="0,10,0,0">
                      <StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                          <Label Style="{StaticResource RowLabel}" Content="{DynamicResource Loc_Layout_NewSentence}" />
                          <Slider x:Name="NewSentenceSecondsSlider" Minimum="1" Maximum="20" Width="220" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="NewSentenceSecondsSlider_ValueChanged" />
                          <TextBlock x:Name="NewSentenceSecondsValue" Width="40" TextAlignment="Right" Foreground="{StaticResource Muted}" Margin="8,0,0,0" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                          <Label Style="{StaticResource RowLabel}" Content="{DynamicResource Loc_Layout_ClearAfter}" />
                          <Slider x:Name="ClearAfterSecondsSlider" Minimum="5" Maximum="120" Width="220" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="ClearAfterSecondsSlider_ValueChanged" />
                          <TextBlock x:Name="ClearAfterSecondsValue" Width="40" TextAlignment="Right" Foreground="{StaticResource Muted}" Margin="8,0,0,0" />
                        </StackPanel>
                        <TextBlock Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="120,2,0,0"
                                   Text="{DynamicResource Loc_Layout_ClearAfterHint}" />
                      </StackPanel>
                    </Border>
                  </TabItem>
                </TabControl>
              </StackPanel>
            </ScrollViewer>
          </Border>

          <!-- Preview + position -->
          <Border Grid.Column="2" Background="{StaticResource Panel}"
                  BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="10" Padding="14">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <Grid Margin="0,0,0,8">
                  <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Loc_Layout_Preview}" Margin="0" VerticalAlignment="Center" />
                  <Button x:Name="LockButton" Style="{StaticResource SecondaryButton}" Content="Lock overlay (click-through)"
                          HorizontalAlignment="Right" Click="LockButton_Click" Padding="10,4" />
                </Grid>

                <CheckBox x:Name="ObsCaptureModeCheck" Content="{DynamicResource Loc_Layout_ObsCaptureMode}"
                          Margin="0,0,0,2"
                          Checked="ObsCaptureModeCheck_Changed" Unchecked="ObsCaptureModeCheck_Changed" />
                <TextBlock Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="22,0,0,8"
                           Text="{DynamicResource Loc_Layout_ObsCaptureModeHint}" />

                <Border x:Name="PreviewSurface" Height="240" CornerRadius="8" BorderBrush="{StaticResource Border}" BorderThickness="1" ClipToBounds="True">
                  <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                      <GradientStop Color="#1A2030" Offset="0" />
                      <GradientStop Color="#0D1220" Offset="1" />
                    </LinearGradientBrush>
                  </Border.Background>
                  <Grid>
                    <Border x:Name="PreviewBubble" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="12">
                      <Grid>
                        <TextBlock x:Name="PreviewOutline" Text="I think this is working pretty well." />
                        <TextBlock x:Name="PreviewText" Text="I think this is working pretty well." />
                      </Grid>
                    </Border>
                  </Grid>
                </Border>

                <GroupBox Header="{DynamicResource Loc_Layout_Position}" Margin="0,12,0,0">
                  <StackPanel>
                    <CheckBox x:Name="FreeformModeCheck" Content="{DynamicResource Loc_Layout_FreeformMode}"
                              Margin="0,0,0,8"
                              Checked="FreeformModeCheck_Changed" Unchecked="FreeformModeCheck_Changed" />

                    <StackPanel x:Name="AnchoredPositionPanel">
                      <StackPanel Style="{StaticResource Row}">
                        <Label Style="{StaticResource RowLabel}" Content="{DynamicResource Loc_Layout_Anchor}" />
                        <ComboBox x:Name="AnchorBox" Width="180" SelectionChanged="AnchorBox_SelectionChanged">
                          <ComboBoxItem Content="TopLeft" />
                          <ComboBoxItem Content="TopCenter" />
                          <ComboBoxItem Content="TopRight" />
                          <ComboBoxItem Content="CenterLeft" />
                          <ComboBoxItem Content="Center" />
                          <ComboBoxItem Content="CenterRight" />
                          <ComboBoxItem Content="BottomLeft" />
                          <ComboBoxItem Content="BottomCenter" />
                          <ComboBoxItem Content="BottomRight" />
                        </ComboBox>
                      </StackPanel>
                      <StackPanel Style="{StaticResource Row}">
                        <Label Style="{StaticResource RowLabel}" Content="{DynamicResource Loc_Layout_OffsetX}" />
                        <Slider x:Name="OffsetXSlider" Minimum="-500" Maximum="500" Width="220" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="OffsetXSlider_ValueChanged" />
                        <TextBlock x:Name="OffsetXValue" Width="40" TextAlignment="Right" Foreground="{StaticResource Muted}" Margin="8,0,0,0" />
                      </StackPanel>
                      <StackPanel Style="{StaticResource Row}">
                        <Label Style="{StaticResource RowLabel}" Content="{DynamicResource Loc_Layout_OffsetY}" />
                        <Slider x:Name="OffsetYSlider" Minimum="-500" Maximum="500" Width="220" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="OffsetYSlider_ValueChanged" />
                        <TextBlock x:Name="OffsetYValue" Width="40" TextAlignment="Right" Foreground="{StaticResource Muted}" Margin="8,0,0,0" />
                      </StackPanel>
                      <TextBlock Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="120,2,0,8"
                                 Text="{DynamicResource Loc_Layout_AnchoredModeHint}" />
                    </StackPanel>

                    <StackPanel x:Name="FreeformPositionPanel" Visibility="Collapsed" Margin="0,0,0,8">
                      <StackPanel Style="{StaticResource Row}">
                        <Label Style="{StaticResource RowLabel}" Content="{DynamicResource Loc_Layout_Mode}" />
                        <TextBlock x:Name="ModeReadout" Text="Free" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                        <Button x:Name="ResetAnchorButton" Content="{DynamicResource Loc_Layout_ResetToAnchor}" Style="{StaticResource SecondaryButton}"
                                Margin="12,0,0,0" Click="ResetAnchorButton_Click" />
                      </StackPanel>
                      <TextBlock Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="120,2,0,0"
                                 Text="{DynamicResource Loc_Layout_FreeformModeHint}" />
                    </StackPanel>

                    <StackPanel Style="{StaticResource Row}">
                      <Label Style="{StaticResource RowLabel}" Content="{DynamicResource Loc_Layout_Width}" />
                      <Slider x:Name="WidthSlider" Minimum="320" Maximum="1920" Width="220" TickFrequency="20" IsSnapToTickEnabled="True" ValueChanged="WidthSlider_ValueChanged" />
                      <TextBlock x:Name="WidthValue" Width="50" TextAlignment="Right" Foreground="{StaticResource Muted}" Margin="8,0,0,0" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource Row}">
                      <Label Style="{StaticResource RowLabel}" Content="{DynamicResource Loc_Layout_Height}" />
                      <Slider x:Name="HeightSlider" Minimum="80" Maximum="1080" Width="220" TickFrequency="10" IsSnapToTickEnabled="True" ValueChanged="HeightSlider_ValueChanged" />
                      <TextBlock x:Name="HeightValue" Width="50" TextAlignment="Right" Foreground="{StaticResource Muted}" Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBlock Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="120,2,0,0"
                               Text="{DynamicResource Loc_Layout_DimensionHint}" />
                  </StackPanel>
                </GroupBox>

              </StackPanel>
            </ScrollViewer>
          </Border>

        </Grid>
      </TabItem>

    </TabControl>
  </Grid>
</Window>

{
  "manifest_version": 3,
  "name": "DeepL Voice Buddy",
  "version": "0.1.0",
  "description": "Real-time translated captions and voiceover for any browser tab, powered by DeepL Voice.",
  "permissions": [
    "tabCapture",
    "offscreen",
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://api.deepl.com/*",
    "https://api-free.deepl.com/*",
    "wss://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "DeepL Voice Buddy",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options.html",
  "web_accessible_resources": [
    {
      "resources": ["worklet.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
